PORT=4000
# JWT_SECRET is auto-generated by scripts/setup-env.js on first boot.
# The value below is a PLACEHOLDER — it is replaced with a real 64-hex-char
# random secret when .env is created. Do NOT use this value in production.
JWT_SECRET=REPLACE_ME_GENERATED_ON_FIRST_BOOT
CAMPUS_EMAIL_DOMAIN=college.edu
DB_PATH=./campussearch.db
NOTIFY_PROVIDER=console
NOTION_API_KEY=your-notion-integration-token-here
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
